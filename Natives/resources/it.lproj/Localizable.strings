"welcome.intro.title" = "Scopri Prisma";
"welcome.intro.f1.title" = "Matrice di renderer e ottimizzazione a livello dispositivo";
"welcome.intro.f1.body" = "MetalGlues/Metallum, Zink+FSR upscaling, ANGLE, VirGL e gl4es — più analisi dei tempi di frame e correzioni delle cause principali sul dispositivo (sblocco 30fps dei modpack, parcheggio GPU in background, rifirma JNA).";
"welcome.intro.f2.title" = "Catena di input profonda";
"welcome.intro.f2.body" = "Digitazione completa da tastiera virtuale, recupero automatico dell'input dopo il background, correzione a quattro direzioni di gamepad/joystick e protezione dei tasti che non cancella mai le tue associazioni personalizzate.";
"welcome.intro.f3.title" = "Prima la sicurezza dei dati";
"welcome.intro.f3.body" = "Isolamento versione con separazione dati/metadati, backup automatico prima della reimportazione dei modpack e riparazione dell'integrità degli asset all'avvio.";
"welcome.intro.f4.title" = "Motore di esportazione parallelo";
"welcome.intro.f4.body" = "Compressione zip a 3 thread con selettore di sezioni (mondi/mod/config/…) e progresso completo: fasi, file, velocità e tempo rimanente.";
"welcome.intro.community.title" = "Unisciti alla community";
"welcome.intro.community.hint" = "Gruppo QQ 1126547426 -- supporto, feedback e annunci delle build. Ti piace il launcher? Sostienici su Afdian (pagina Informazioni).";
"welcome.intro.next_hint" = "A presto si aprirà la pagina Informazioni — info versione, gruppo QQ e controllo aggiornamenti sono lì.";

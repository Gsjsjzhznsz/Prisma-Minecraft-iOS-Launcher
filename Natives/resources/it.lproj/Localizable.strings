"mp.guide.intro" = "ZeroTier offre due modalità multigiocatore; scegli quella che ti serve:";
"mp.guide.mode_fast" = "Modalità rapida";
"mp.guide.mode_fast_desc" = "Genera automaticamente un Network ID tramite una rete ad-hoc — nessun account necessario. Solo IPv6, su una rete pubblica con sicurezza più debole; l'IP può cambiare.";

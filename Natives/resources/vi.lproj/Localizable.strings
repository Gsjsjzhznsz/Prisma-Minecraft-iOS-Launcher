"ai.crash.gl.explanation" = "It's like a driver holding a class-B license trying to drive a heavy truck — the license class doesn't match. The game tried to initialize the display through the graphics interface (OpenGL/GLFW/GLX), but the current renderer's support is incomplete or the driver is incompatible.";
"ai.crash.gl.sugg1" = "Switch to another renderer in the launcher settings (e.g. MobileGlues / GL4ES / Auto).";
"ai.crash.gl.sugg2" = "Update the launcher or the game to a newer version, or lower the OpenGL version requirement.";
"ai.crash.gl.sugg3" = "Reset/restore the default renderer configuration in the settings and try again.";
"ai.crash.gl262.explanation" = "Minecraft 26.2 triggered an OpenGL syntax error in the iOS rendering layer — a compatibility issue between the current renderer and this version.";
"ai.crash.gl262.sugg1" = "Switch this instance's renderer to MoltenVK (set_setting: key=video.renderer, value=MoltenVK).";
"ai.crash.gl262.sugg2" = "After switching the renderer, restart the game to verify.";
"ai.crash.javaver.explanation" = "It's like speaking Mandarin to someone who only speaks a dialect — you're talking past each other. The Java version required by this game version doesn't match the Java the launcher currently provides, so it cannot start.";
"ai.crash.javaver.sugg1" = "In the launcher's version manager, confirm the Java version required by this game version and install the matching Java (8/17/21, etc.).";
"ai.crash.javaver.sugg2" = "Use the launcher's recommended option that picks the Java version automatically.";
"ai.crash.jit.explanation" = "This is caused by JIT (just-in-time compilation) not being enabled correctly: a black screen after launch or an immediate crash.";
"ai.crash.jit.sugg1" = "Pick a JIT method in Settings > Debug (Auto / StikDebug / SideStore / StosDebug / JitStreamer-EB / TrollStore / Manual) and relaunch.";
"ai.crash.jit.sugg2" = "If it still fails, report via GitHub Issues or the official QQ group (1126547426) with logs.";
"ai.crash.jni.explanation" = "JNI is like your \"visa\" that lets the game (Java) pass through to the native core libraries. If the visa is expired or the paperwork is incomplete (native libraries missing or the wrong version), Java won't be let through and startup fails immediately.";
"ai.crash.jni.sugg1" = "Reinstall/re-download the game so the core libraries are fully written to disk.";
"ai.crash.jni.sugg2" = "Make sure a full Java runtime is being used (not a trimmed-down one).";
"ai.crash.jni.sugg3" = "If the native libraries are corrupted, delete that version and reinstall it.";
"ai.crash.launchercrash.explanation" = "The launcher itself crashed (rather than the game); developer investigation is needed.";
"ai.crash.launchercrash.sugg1" = "Report via GitHub Issues (Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher) or the official QQ group (1126547426) with latestlog.txt.";
"ai.crash.launchercrash.sugg2" = "Include device model, OS version and repro steps so it can be diagnosed.";
"ai.crash.lwjgl.explanation" = "This launcher runs the game on an LWJGL 3.4.1 compatibility layer; some older game/mod combinations may not fit it.";
"ai.crash.lwjgl.sugg1" = "Check the compatibility between the game version and the LWJGL version (for older games, use the matching older instance configuration).";
"ai.crash.lwjgl.sugg2" = "Report the exact version combination via GitHub Issues or the official QQ group (1126547426).";
"ai.crash.magickeyboard.explanation" = "This is a known compatibility issue triggered by tapping the Magic Keyboard on iOS.";
"ai.crash.magickeyboard.sugg1" = "If it disrupts daily use, report your device model and repro steps via GitHub Issues or the official QQ group (1126547426).";
"ai.crash.magickeyboard.sugg2" = "Until it is fixed, avoid connecting/clicking the Magic Keyboard, or use touch and the on-screen keyboard instead.";
"ai.crash.missing_params" = "Provide at least one of log or crashReport";
"ai.crash.nomatch.explanation" = "No known error type matched, so the cause cannot be pinpointed directly.";
"ai.crash.nomatch.sugg1" = "Try launching once more and see whether it reproduces consistently.";
"ai.crash.nomatch.sugg2" = "Send the full log or the exported crash report to the community/developers for feedback on the forum.";
"ai.crash.nomatch.sugg3" = "Temporarily disable mods and shader packs and check one by one whether a particular resource is causing it.";
"ai.crash.oom.explanation" = "It's like having only your monthly paycheck while paying rent, utilities and snacks at the same time, until the balance runs dry. The game ran out of memory (available space): when Java tried to allocate more, the system refused, so it crashed.";
"ai.crash.oom.sugg1" = "Increase the game's allocated memory in the launcher settings (the -Xmx in the Java arguments — give the \"paycheck\" a raise).";
"ai.crash.oom.sugg2" = "Disable or reduce installed mods and shader packs to ease the \"rent pressure\".";
"ai.crash.oom.sugg3" = "If adjusting memory doesn't help, try lowering the render distance and disabling shaders.";
"ai.crash.range.explanation" = "It's like stuffing 5 boxes into a cabinet with only 3 drawers — the numbers don't add up. Some value (version/index/range) went outside its valid range, usually caused by corrupted config files or a version mismatch.";
"ai.crash.range.sugg1" = "Delete/reset the related config files of this instance and recreate them.";
"ai.crash.range.sugg2" = "Reinstall that game version to avoid mixing in corrupted old configs.";
"ai.crash.sdl3.explanation" = "Minecraft 26.3+ moved from LWJGL to SDL3; this launcher ships the SDL3 path. This error usually means the loader/API mod version or renderer is not a good fit for 26.3.";
"ai.crash.sdl3.sugg1" = "Check the 26.3 troubleshooting entries in Help & FAQ (Fabric API/Sodium versions, renderer, etc.); if it still fails, report via GitHub Issues or the official QQ group (1126547426) with logs.";

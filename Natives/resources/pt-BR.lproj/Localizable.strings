"welcome.intro.title" = "Conheça o Prisma";
"welcome.intro.f1.title" = "Matriz de renderizadores e ajuste por dispositivo";
"welcome.intro.f1.body" = "Cinco renderizadores — MetalGlues/Metallum, Zink+FSR, ANGLE, VirGL e gl4es — além de análise forense de tempo de quadro e correções de causa raiz no dispositivo (liberação de 30fps em modpacks, GPU estacionada em segundo plano, reassinatura de JNA).";
"welcome.intro.f2.title" = "Cadeia de entrada profunda";
"welcome.intro.f2.body" = "Digitação completa pelo teclado virtual, recuperação automática da entrada após voltar do segundo plano, correção das quatro direções de gamepad/analógico e proteção de teclas — seus atalhos personalizados nunca são perdidos.";
"welcome.intro.f3.title" = "Segurança dos dados em primeiro lugar";
"welcome.intro.f3.body" = "Isolamento de versão com separação de dados/metadados, backup automático antes de reimportar modpacks e reparo automático da integridade de assets na inicialização.";
"welcome.intro.f4.title" = "Motor de exportação paralela";
"welcome.intro.f4.body" = "Compressão zip com 3 threads + seletor de seções (mundos/mods/config/…) e progresso completo: etapas, arquivos, velocidade e tempo restante.";
"welcome.intro.community.title" = "Junte-se à comunidade";
"welcome.intro.community.hint" = "Grupo do QQ 1126547426 -- apoio, feedback e avisos de compilações. Gostou do launcher? Apoie-nos no Afdian (página Sobre).";
"welcome.intro.next_hint" = "Em seguida abriremos a página “Sobre” -- informações da versão, grupo do QQ e verificação de atualizações ficam lá.";

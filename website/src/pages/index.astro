    <script>
      // ★ Task261 ①：语言切换（localStorage 持久化；head 内联脚本已预应用）。
      (function () {
        var btn = document.getElementById('langToggle');
        function current() { return document.documentElement.dataset.lang === 'en' ? 'en' : 'zh'; }
        function render() {
          btn.textContent = current() === 'zh' ? 'EN' : '中文';
          btn.title = current() === 'zh' ? 'Switch to English' : '切换到中文';
        }
        btn.addEventListener('click', function () {
          var next = current() === 'zh' ? 'en' : 'zh';
          if (next === 'en') document.documentElement.dataset.lang = 'en';
          else delete document.documentElement.dataset.lang;
          try { localStorage.setItem('prisma-lang', next); } catch (e) {}
          render();
        });
        render();
      })();

      // ★ Task261 ⑩：自动识别最新发行版（GitHub Releases API；1h localStorage
      // 缓存；失败静默回退构建期版本 —— 国内网络无代理时 API 常不可达，
      // 页面主体此时仍展示构建期版本与加速源链接，零阻断）。
      // ★ Task291 版本检测链路加固：
      //   ① API 挂了不再丢自己的缓存——过期缓存照样上（老版本也比错版本强），
      //      只有连缓存都没有才停在构建期兜底标签；
      //   ② 显式校验 prerelease/draft（/releases/latest 理论上已排除，双保险）；
      //   ③ 403/429（限流）与网络错误同路处理，不重试轰炸；
      //   ④ 导航 CTA 与 hero 徽章版本文案随检测结果一并更新（旧版只更新
      //      dl-tag，检测成功后导航还写着旧版本号）。
      (function () {
        var REPO_API = 'https://api.github.com/repos/Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher/releases/latest';
        var KEY = 'prisma-latest-release';
        var TAG_RE = /^v?\d+(\.\d+)*(-\S+)?$/;
        var BUILD_TAG = (document.body && document.body.getAttribute('data-build-tag')) || 'v6.5.0';
        function tag(v) { return v && typeof v === 'string' && TAG_RE.test(v) ? (v.charAt(0) === 'v' ? v : 'v' + v) : null; }
        function ipa(t) { return 'https://github.com/Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher/releases/download/' + t + '/com.prisma-devs.prisma-' + t.slice(1) + '-ios.ipa'; }
        function tipa(t) { return 'https://github.com/Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher/releases/download/' + t + '/com.prisma-devs.prisma-' + t.slice(1) + '-ios-trollstore.tipa'; }
        function rel(t) { return 'https://github.com/Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher/releases/tag/' + t; }
        function setText(id, text) { var el = document.getElementById(id); if (el) el.textContent = text; }
        function apply(t) {
          setText('dl-tag', t);
          setText('dl-tag-en', t);
          setText('nav-cta-zh', '下载 ' + t.slice(1));
          setText('nav-cta-en', 'Download ' + t.slice(1));
          var chipZh = document.querySelector('.hero .chip .lang-zh');
          var chipEn = document.querySelector('.hero .chip .lang-en');
          if (chipZh) chipZh.textContent = t + ' 正式版 · 包名迁移至 com.prisma-devs.prisma';
          if (chipEn) chipEn.textContent = t + ' stable · bundle id moved to com.prisma-devs.prisma';
          var map = { 'hero-ipa-btn': ipa(t), 'hero-tipa-btn': tipa(t), 'hero-release-btn': rel(t),
                      'dl-ipa-btn': ipa(t), 'dl-tipa-btn': tipa(t), 'dl-release-btn': rel(t) };
          Object.keys(map).forEach(function (id) {
            var el = document.getElementById(id); if (el) el.href = map[id];
          });
          var row = document.getElementById('mirror-row');
          if (row) {
            row.querySelectorAll('[data-mirror]').forEach(function (chip) {
              var asset = chip.getAttribute('data-mirror-asset') === 'tipa' ? tipa(t) : ipa(t);
              chip.href = chip.getAttribute('data-mirror') + asset;
            });
          }
        }
        function readCache() {
          try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
        }
        // 回退链：过期缓存 → 构建期兜底标签（静态链接本就指向它，此处仅对齐文案）
        function fallbackAfterFailure() {
          var cached = readCache();
          var stale = cached && tag(cached.tag);
          if (stale) { apply(stale); return; }
          apply(BUILD_TAG);
        }
        var cached = readCache();
        if (cached && cached.ts && (Date.now() - cached.ts < 3600 * 1000) && tag(cached.tag)) {
          apply(tag(cached.tag));
          return;
        }
        fetch(REPO_API, { headers: { Accept: 'application/vnd.github+json' } })
          .then(function (r) {
            // 403/429 = 限流（共享出口 IP 常态）：走回退链，不打重试
            if (r.status === 403 || r.status === 429) return null;
            return r.ok ? r.json() : null;
          })
          .then(function (j) {
            var t = j && !j.draft && !j.prerelease && tag(j.tag_name);
            if (!t) { fallbackAfterFailure(); return; }
            try { localStorage.setItem(KEY, JSON.stringify({ ts: Date.now(), tag: t })); } catch (e) {}
            apply(t);
          })
          .catch(fallbackAfterFailure);
      })();
    </script>
  </body>

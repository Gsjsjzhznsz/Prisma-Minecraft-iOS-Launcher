          </div>
          <div class="mirror-row" id="mirror-row">
            {GH_MIRRORS.map((m) => (
              <a class="mirror-chip" data-mirror={m.prefix} href={m.prefix + IPA(FALLBACK_TAG)}>
                <span class="mirror-name">{m.name}</span>

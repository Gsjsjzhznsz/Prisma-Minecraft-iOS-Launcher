---
// Prisma 启动器介绍站 v2 —— Task261：①中英双语（client 端 lang 切换，
// localStorage 持久化 + head 内联预应用防 FOUC）②交流社区 + 捐赠区块
// （渠道取自 README 单一事实源：QQ 群 / Discord / 爱发电 / 微信赞赏码）
// ③下载区自动识别最新版（GitHub Releases API + 1h 本地缓存 + 构建期
// 兜底常量）+ 国内 gh 加速源前缀组 + GitHub 发行版直达。
// 公告数据：构建期 scripts/sync-announcements.mjs 从仓库 main 同步。
// ★ Task291 发行版版本检测根修：构建期兜底常量不再手写——website.yml
// 在 npm build 前用 GITHUB_TOKEN 服务端探测最新“非预发布”发行版注入
// PUBLIC_LATEST_TAG（工作流另加 schedule 每日刷新），探测失败回落
// 静态 v6.5.0。旧静态值 v6.5.5 是预发布 Beta（GitHub Latest 实际是
// v6.5.0），国内 API 不可达时页面把 Beta 当正式版展示 = 版本检查
// 问题直接来源。
import '../styles/global.css';
import announcements from '../data/announcements.json';

const REPO = 'https://github.com/Gsjsjzhznsz/Prisma-Minecraft-iOS-Launcher';
const ame291EnvTag = (import.meta.env.PUBLIC_LATEST_TAG || '').trim();
const ame291TagOk = /^v?\d+(\.\d+)*(-[A-Za-z0-9.]+)?$/.test(ame291EnvTag);
const FALLBACK_TAG = ame291TagOk
  ? (ame291EnvTag.charAt(0) === 'v' ? ame291EnvTag : 'v' + ame291EnvTag)
  : 'v6.5.0';
const FALLBACK_TAG_SHORT = FALLBACK_TAG.replace(/^v/, '');
const releaseUrl = (tag) => `${REPO}/releases/tag/${tag}`;
const assetUrl = (tag, name) => `${REPO}/releases/download/${tag}/${name}`;
const IPA = (tag) => assetUrl(tag, `com.prisma-devs.prisma-${tag.replace(/^v/, '')}-ios.ipa`);
const TIPA = (tag) => assetUrl(tag, `com.prisma-devs.prisma-${tag.replace(/^v/, '')}-ios-trollstore.tipa`);
const LEGACY_AIR = assetUrl(FALLBACK_TAG, 'com.air-devs.air-legacy-EXPORT-ONLY.ipa');
const DONATE_WECHAT = `${REPO}/raw/main/donate.png`;
const AFDIAN = 'https://afdian.com/a/yiqiu4178';
const DISCORD = 'https://discord.gg/HqcmswrEy';
const BASE = '/Prisma-Minecraft-iOS-Launcher';

// 国内 GitHub 下载加速源（前缀拼接型；可用性随网络环境波动，页面同时
// 保留 GitHub 直达与多个镜像，用户可自行选用）。
const GH_MIRRORS = [
  { name: 'ghfast.top', prefix: 'https://ghfast.top/' },
  { name: 'gh-proxy.com', prefix: 'https://gh-proxy.com/' },
  { name: 'ghproxy.net', prefix: 'https://ghproxy.net/' },
];

const pinned = [...announcements.announcements].sort(
  (a, b) => (b.pin === true ? 1 : 0) - (a.pin === true ? 1 : 0) || b.date.localeCompare(a.date)
);

const features = [
  {
    icon: '🫧',
    zh: { title: 'iOS 27 液态玻璃', body: 'Telegram 同款实况 backdrop 采样 + SDF 边缘折射，面板、弹窗、游戏内菜单整族玻璃质感；四档可选、最低档全透明；降低透明度自动回退原生，老版本会话自动安全降级。' },
    en: { title: 'iOS 27 Liquid Glass', body: 'Telegram-style live backdrop sampling with SDF edge refraction across panels, dialogs and in-game menus. Four intensity tiers, fully transparent at the lowest; gracefully falls back to native styling when Reduce Transparency is on or on legacy sessions.' },
  },
  {
    icon: '🎮',
    zh: { title: '渲染矩阵 + FSR 超分', body: 'MobileGL（Vulkan 直连 / GLES / GL 4.0）、ANGLE、VirGL、kw/gl4es 全后端矩阵；FSR 1.0 低分辨率渲染 + 放大锐化；自动渲染器按版本基线选择 + 崩溃自学降档。' },
    en: { title: 'Render Matrix + FSR', body: 'Full backend matrix: MobileGL (Vulkan / GLES / GL 4.0), ANGLE, VirGL and kw/gl4es. FSR 1.0 renders low-res then upscales with sharpening. The auto renderer picks by version baseline and learns from crashes to step down safely.' },
  },
  {
    icon: '🌐',
    zh: { title: '内置联机（Terracotta）', body: 'EasyTier 内核：房间码 / 玩家列表 / 对局端口状态面板；访客掉线自动重试、主机端口周期扫描；游戏内玻璃菜单按会话版本自动安全降级。' },
    en: { title: 'Built-in Multiplayer', body: 'EasyTier-powered Terracotta: room codes, player lists and live match port panels. Guests auto-retry on disconnect, hosts get periodic port scanning; the in-game glass menu degrades safely per session version.' },
  },
  {
    icon: '⬇️',
    zh: { title: '国内下载提速', body: 'BMCLAPI / MCIM 镜像矩阵 + 延迟×吞吐量双维度测速选路（128KB 实测持续速率，不再被低延迟官方源误导）；统一进度页实时显示当前文件、速率、双维度计数与 ETA。' },
    en: { title: 'Fast CN Downloads', body: 'BMCLAPI / MCIM mirror matrix with dual-dimension routing (latency × sustained 128KB throughput — no more misleading low-latency probes). A unified progress page shows the current file, speed and ETA in real time.' },
  },
  {
    icon: '🧩',
    zh: { title: '整合包一站式', body: 'Modrinth / CurseForge 整合包在线安装，Fabric / Forge / NeoForge / Quilt 加载器直装；FCL 风格版本隔离三态选择 + 数据自动迁移；26.x 组件下载全线根治。' },
    en: { title: 'One-stop Modpacks', body: 'Install Modrinth / CurseForge modpacks online; Fabric / Forge / NeoForge / Quilt loaders out of the box; FCL-style instance isolation (three-state) with automatic data migration; 26.x component downloads fully fixed.' },
  },
  {
    icon: '🤖',
    zh: { title: 'AI 助手', body: '内置 AI 对话（提供商可配置 / 会话列表 / 系统提示词编辑），启动器问题随问随答；全部本地偏好，不强绑任何账号体系。' },
    en: { title: 'AI Assistant', body: 'Built-in AI chat with configurable providers, session history and system-prompt editing. Ask anything about the launcher; everything stays in local preferences with no account binding.' },
  },
  {
    icon: '🛟',
    zh: { title: '数据安全与迁移', body: '全量数据一键导出 / 导入（zip 分区可选）；LiveContainer 同宿主检测到旧包名数据时一键迁移；跨包名升级不丢档。' },
    en: { title: 'Data Safety & Migration', body: 'One-tap full export / import (optional zip split). LiveContainer sibling detection migrates legacy-bundle data automatically; switching app bundle IDs never loses your worlds.' },
  },
  {
    icon: '🔬',
    zh: { title: '深度诊断', body: 'fatal trace / hs_err / JVM 日志三件套自动留存；主线程看门狗；带日志的问题一轮定位，社区反馈闭环快。' },
    en: { title: 'Deep Diagnostics', body: 'fatal trace / hs_err / JVM logs are captured automatically on every launch; a main-thread watchdog samples stalls. Attach the logs and community reports converge in one round.' },
  },
];

const diffs = [
  ['界面语言', '上游为原生化flat风格', 'iOS 27 液态玻璃全家桶：TG 同款实况折射引擎、四档风格、界面/文字双缩放、动态反色', 'Visuals', 'Native flat style', 'Full iOS 27 liquid-glass suite: TG-style live refraction engine, four style tiers, dual UI/text scaling, dynamic contrast'],
  ['渲染', '单渲染器全局选择', '每游戏渲染器 + mg 三后端 FSR 1.0 + 崩溃自学降档 + 版本基线自动选择', 'Rendering', 'Single global renderer', 'Per-game renderer + MobileGL 3-backend FSR 1.0 + crash-learning downgrade + version-baseline auto selection'],
  ['联机', '依赖外部局域网工具', '内置 Terracotta/EasyTier：房间码、状态面板、自动重试、周期端口扫描全自动化', 'Multiplayer', 'External LAN tools', 'Built-in Terracotta/EasyTier: room codes, status panels, auto-retry, periodic port scanning — all automated'],
  ['下载', '官方源为主', 'BMCLAPI/MCIM 镜像矩阵 + 延迟×吞吐量双维测速 + 断点续传 + 文件级进度明细', 'Downloads', 'Official sources', 'BMCLAPI/MCIM mirror matrix + latency×throughput probing + resumable transfers + per-file progress'],
  ['整合包', '基础安装', 'Modrinth/CurseForge 在线装 + 版本隔离三态 + 26.x 全线兼容 + 组件下载根治', 'Modpacks', 'Basic install', 'Modrinth/CurseForge online install + three-state isolation + full 26.x compatibility + component fixes'],
  ['数据', '无迁移能力', '全量导出/导入（分区可选）+ LiveContainer 兄弟目录一键迁移 + 实例感知收尾', 'Data', 'No migration', 'Full export/import (optional split) + one-tap LiveContainer sibling migration + instance-aware finalization'],
  ['可诊断性', '基础日志', 'fatal trace/hs_err/JVM 三件套 + 主线程看门狗 + 渲染/输入探针矩阵', 'Diagnostics', 'Basic logs', 'fatal trace/hs_err/JVM trio + main-thread watchdog + render/input probe matrix'],
];

const quickstart = {
  zh: [
    '下载 IPA 并侧载（AltStore / SideStore / 爱思助手 / TrollStore 装 TIPA）',
    '首次启动走欢迎向导：语言 → 下载源 → 数据迁移（检测到旧版数据可一键迁移）→ 界面风格',
    '开启 JIT（设置 > JIT：StikDebug / SideStore / TrollStore Magnifier 均可）',
    '下载一个 Minecraft 版本（或导入整合包），点击启动',
  ],
  en: [
    'Download the IPA and sideload it (AltStore / SideStore / i4 Tools; use the TIPA with TrollStore)',
    'First launch runs the welcome wizard: language → download source → data migration (one-tap if legacy data is detected) → appearance',
    'Enable JIT (Settings > JIT: StikDebug / SideStore / TrollStore Magnifier all work)',
    'Download a Minecraft version (or import a modpack) and hit Play',
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prisma —— iOS Minecraft 启动器 · Prisma — Minecraft Launcher for iOS</title>
    <meta name="description" content="Prisma：iOS 平台 Minecraft Java 版启动器。iOS 27 液态玻璃界面、每游戏渲染器 + FSR 超分、内置联机、国内镜像加速下载、AI 助手、数据一键迁移。Prisma: a Minecraft Java Edition launcher for iOS with liquid-glass UI, per-game renderers, FSR upscaling, built-in multiplayer and CN mirror downloads." />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}/favicon.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${BASE}/icon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}/icon-180.png`} />
    <script is:inline>
      // Task261：语言偏好预应用（防 FOUC）。默认中文。
      try {
        var ameLang = localStorage.getItem('prisma-lang');
        if (ameLang === 'en') document.documentElement.dataset.lang = 'en';
      } catch (e) {}
    </script>
  </head>
  <body data-build-tag={FALLBACK_TAG}>
    <div class="aurora"></div>
    <div class="grain"></div>

    <header class="topbar wrap">
      <div class="glass">
        <div class="brand"><img class="logo" src={`${BASE}/icon-32.png`} alt="Prisma icon" />Prisma</div>
        <nav class="topnav">
          <a href="#features"><span class="lang-zh">特性</span><span class="lang-en">Features</span></a>
          <a href="#tour"><span class="lang-zh">视觉巡礼</span><span class="lang-en">Tour</span></a>
          <a href="#upstream"><span class="lang-zh">与上游的区别</span><span class="lang-en">vs Upstream</span></a>
          <a href="#community"><span class="lang-zh">交流与支持</span><span class="lang-en">Community</span></a>
          <a href="#announcements"><span class="lang-zh">公告</span><span class="lang-en">News</span></a>
          <a href={REPO} target="_blank" rel="noopener">GitHub</a>
          <a class="cta" href="#download"><span class="lang-zh" id="nav-cta-zh">下载 {FALLBACK_TAG_SHORT}</span><span class="lang-en" id="nav-cta-en">Download</span></a>
          <button id="langToggle" class="lang-btn" type="button" aria-label="切换语言 / Switch language">EN</button>
        </nav>
      </div>
    </header>

    <section class="hero wrap">
      <img class="hero-icon" src={`${BASE}/icon-192.png`} alt="Prisma launcher icon" width="128" height="128" />
      <span class="chip"><span class="dot"></span><span class="lang-zh">{FALLBACK_TAG} 正式版 · 包名迁移至 com.prisma-devs.prisma</span><span class="lang-en">{FALLBACK_TAG} stable · bundle id moved to com.prisma-devs.prisma</span></span>
      <h1>Prisma</h1>
      <p class="lead">
        <span class="lang-zh">
          iOS 平台 Minecraft Java 版启动器。从渲染矩阵、输入链路到联机与下载全链自研调优，
          为 iPhone 与 iPad 打造独一无二的 iOS 27 液态玻璃体验。
        </span>
        <span class="lang-en">
          A Minecraft: Java Edition launcher for iOS. Fully in-house tuning across the render
          matrix, input pipeline, multiplayer and downloads — a one-of-a-kind iOS 27 liquid-glass
          experience for iPhone and iPad.
        </span>
      </p>
      <div class="actions">
        <a class="btn primary" id="hero-ipa-btn" href={IPA(FALLBACK_TAG)}>⬇ <span class="lang-zh">下载 IPA（侧载）</span><span class="lang-en">Download IPA (sideload)</span></a>
        <a class="btn ghost" id="hero-tipa-btn" href={TIPA(FALLBACK_TAG)}><span class="lang-zh">TrollStore TIPA</span><span class="lang-en">TrollStore TIPA</span></a>
        <a class="btn ghost" id="hero-release-btn" href={releaseUrl(FALLBACK_TAG)}><span class="lang-zh">发行说明</span><span class="lang-en">Release notes</span></a>
      </div>
      <p class="meta-note">
        <span class="lang-zh">iOS 15+ · iPadOS 支持 · 首次启动游戏需开启 JIT · 旧版数据一键迁移</span>
        <span class="lang-en">iOS 15+ · iPadOS supported · JIT required for first game launch · one-tap legacy data migration</span>
      </p>
      <!-- Task312：服务地区声明横幅（明面不对大陆开放） -->
      <div style="margin-top:18px;border:1px solid #e8b93e55;background:#e8b93e14;border-radius:12px;padding:14px 18px;text-align:left;">
        <b>⚠️ <span class="lang-zh">服务地区声明</span><span class="lang-en">Region Notice</span></b><br/>
        <span class="lang-zh">本启动器<b>不对中国大陆地区用户开放</b>。Prisma 为社区项目，与 Mojang Studios、Microsoft 及网易（中国大陆地区代理方）均无关联，未在中国大陆地区进行分发或提供服务。启动器会通过设备地区 / 时区 / 运营商 / 语言 / IP 归属地多角度互证检测疑似大陆用户并弹出声明，提供「我不是大陆用户」按钮，连续 3 次确认后放行。</span>
        <span class="lang-en">This launcher is <b>NOT available to users in mainland China</b>. Prisma is a community project, unaffiliated with Mojang Studios, Microsoft, or NetEase (the mainland China publisher), and is not distributed or serviced in mainland China. The app detects suspected mainland users via corroborated on-device signals (region / timezone / carrier / language / IP geolocation), shows a "Service Region Notice" with an "I am not a mainland user" button, and releases after 3 confirmations.</span>
      </div>
    </section>

    <section id="features" class="wrap">
      <h2 class="sec"><span class="lang-zh">功能全景</span><span class="lang-en">Feature Overview</span></h2>
      <p class="sec-sub">
        <span class="lang-zh">八个方向，全部来自真实装机的逐项反馈闭环（190+ 次提交、11 轮装机迭代）。</span>
        <span class="lang-en">Eight directions, every one closed-loop from real device feedback (190+ commits, 11 device-testing iterations).</span>
      </p>
      <div class="grid lang-zh">
        {features.map((f) => (
          <div class="glass card">
            <div class="icon">{f.icon}</div>
            <h3>{f.zh.title}</h3>
            <p>{f.zh.body}</p>
          </div>
        ))}
      </div>
      <div class="grid lang-en">
        {features.map((f) => (
          <div class="glass card">
            <div class="icon">{f.icon}</div>
            <h3>{f.en.title}</h3>
            <p>{f.en.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ★ Task265：视觉巡礼（用户自制的两份 HTML 介绍页入站：PPT 播放版 + 竖屏滑动版） -->
    <section id="tour" class="wrap">
      <h2 class="sec"><span class="lang-zh">视觉巡礼</span><span class="lang-en">Visual Tour</span></h2>
      <p class="sec-sub">
        <span class="lang-zh">两种节奏，同一场 Prisma 视觉巡礼：大屏放映版逐页讲解，竖屏滑动版一屏一景随手翻。均为全屏独立页面，点开即看。</span>
        <span class="lang-en">One tour, two rhythms: the deck mode walks through page by page, the vertical mode flows screen by screen. Both are standalone fullscreen pages — tap and enjoy.</span>
      </p>
      <div class="grid">
        <div class="glass card tour-card">
          <div class="icon">🎞️</div>
          <h3><span class="lang-zh">放映模式（PPT）</span><span class="lang-en">Deck Mode (PPT)</span></h3>
          <p><span class="lang-zh">逐页放映的完整介绍：界面、渲染、联机、下载与诊断全家桶，适合投屏 / 平板横屏浏览。方向键或点击翻页。</span>
          <span class="lang-en">The full story as a slide deck: UI, rendering, multiplayer, downloads and diagnostics — great for casting or landscape tablets. Arrow keys or tap to advance.</span></p>
          <a class="btn ghost tour-btn" href={`${BASE}/showcase.html`} target="_blank" rel="noopener">
            <span class="lang-zh">打开放映版 →</span><span class="lang-en">Open deck →</span>
          </a>
        </div>
        <div class="glass card tour-card">
          <div class="icon">📱</div>
          <h3><span class="lang-zh">竖屏滑动模式</span><span class="lang-en">Vertical Scroll Mode</span></h3>
          <p><span class="lang-zh">为手机竖屏设计的滑动式介绍：一屏一景上下滑动，地铁上也能刷完的 Prisma 全景。</span>
          <span class="lang-en">A scrollytelling tour designed for phones in portrait: one scene per screen, the whole Prisma story in a thumb swipe.</span></p>
          <a class="btn ghost tour-btn" href={`${BASE}/scrolly.html`} target="_blank" rel="noopener">
            <span class="lang-zh">打开滑动版 →</span><span class="lang-en">Open scroll →</span>
          </a>
        </div>
      </div>
    </section>

    <section id="upstream" class="wrap">
      <h2 class="sec"><span class="lang-zh">我们与上游的区别</span><span class="lang-en">How We Differ from Upstream</span></h2>
      <p class="sec-sub">
        <span class="lang-zh">Prisma 基于 PojavLauncher（iOS）与 Amethyst 社区成果构建，但远不止换皮——每一项差异都对应一条真实装机反馈的根修闭环。</span>
        <span class="lang-en">Prisma builds on PojavLauncher (iOS) and Amethyst community work — far beyond a reskin. Every difference below traces back to a real device-report fix.</span>
      </p>
      <div class="glass diff-card lang-zh">
        <table class="diff-table">
          <thead><tr><th>维度</th><th>上游（PojavLauncher / Amethyst）</th><th>Prisma</th></tr></thead>
          <tbody>
            {diffs.map((d) => (
              <tr><td class="dim-k">{d[0]}</td><td class="dim-up">{d[1]}</td><td class="dim-pr">{d[2]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="glass diff-card lang-en">
        <table class="diff-table">
          <thead><tr><th>Dimension</th><th>Upstream (PojavLauncher / Amethyst)</th><th>Prisma</th></tr></thead>
          <tbody>
            {diffs.map((d) => (
              <tr><td class="dim-k">{d[3]}</td><td class="dim-up">{d[4]}</td><td class="dim-pr">{d[5]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="quickstart" class="wrap">
      <h2 class="sec"><span class="lang-zh">四步上手</span><span class="lang-en">Quick Start</span></h2>
      <p class="sec-sub">
        <span class="lang-zh">从下载到进入世界的最短路径。</span>
        <span class="lang-en">The shortest path from download to your first world.</span>
      </p>
      <div class="glass qs-card">
        <ol class="qs lang-zh">
          {quickstart.zh.map((s) => <li>{s}</li>)}
        </ol>
        <ol class="qs lang-en">
          {quickstart.en.map((s) => <li>{s}</li>)}
        </ol>
        <p class="qs-note">
          <span class="lang-zh">系统要求：iOS 15+（液态玻璃视觉需 iOS 26+，低版本自动回退原生观感）；设备需支持 Metal；联机功能无需额外账号。</span>
          <span class="lang-en">Requirements: iOS 15+ (liquid-glass visuals need iOS 26+, older versions fall back to native styling); Metal-capable device; multiplayer needs no extra accounts.</span>
        </p>
      </div>
    </section>

    <!-- ★ Task261 ⑦：交流与支持区块（渠道取自 README 单一事实源） -->
    <section id="community" class="wrap">
      <h2 class="sec"><span class="lang-zh">交流与支持</span><span class="lang-en">Community &amp; Support</span></h2>
      <p class="sec-sub">
